{
  "name": "archvoice-server",
  "version": "1.0.0",
  "description": "Backend API and AI Intent Processor for ArchVoice",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "npx prisma db push && node src/index.js",
    "dev": "nodemon src/index.js",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@prisma/client": "^5.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "prisma": "^5.10.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
